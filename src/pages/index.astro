---
// Trang chủ: trang giới thiệu duy nhất của site, dựng theo quy trình của tasteskill 2.5.1
// (design-taste-frontend). Khung trang là markup và class của bộ kit trong public/assets
// (chép nguyên, không sửa). Các hình minh họa giao diện dùng đúng class .ccf-* của
// src/styles/course.css, nên luôn giống giao diện thật của trang bài học.
// Nội dung trong hình lấy từ bài học thật: câu hỏi của bài 1.1, câu hỏi thi thử domain 1,
// flashcard của bài "API Gateway", output mẫu của lab 1.7.
import fs from 'node:fs';
import path from 'node:path';
import '../styles/tokens.css';
import '../styles/course.css';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const kit = `${base}/assets`;
const site = new URL(`${base}/`, Astro.site ?? 'https://kien-duy.github.io').href;
const cca = `${base}/cca/`;
const sd = `${base}/system-design/`;
const exam = `${base}/cca/on-tap/thi-thu/`;
const roadmap = `${base}/cca/bat-dau/lo-trinh/`;
const howto = `${base}/cca/bat-dau/cach-hoc/`;
const labPrep = `${base}/cca/bat-dau/chuan-bi-lab/`;

// Ngày chụp thật của trang tài liệu hiện trong hình ngăn trượt (public/docs-snapshot sinh lúc build).
let snapDate = '';
try {
	const index = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public/docs-snapshot/index.json'), 'utf8'));
	snapDate = index.pages?.['https://platform.claude.com/docs/en/build-with-claude/handling-stop-reasons']?.date ?? '';
} catch {
	/* chưa có bản chụp: hình không ghi ngày */
}

const today = new Date().toISOString().slice(0, 10);
const title = 'Khóa học Architect: hai khóa tự học cho lập trình viên';
const description =
	'Luyện thi Claude Certified Architect với 29 bài, 5 lab và đề thi thử 60 câu; học System Design với 38 bài và 307 flashcard. Miễn phí, tiếng Việt, không chính thức.';

const domains = [
	{ n: 1, name: 'Kiến trúc agent và điều phối', meta: '6 bài, 1 lab, 1 quiz', pct: 27 },
	{ n: 2, name: 'Thiết kế tool và tích hợp MCP', meta: '5 bài, 1 lab, 1 quiz', pct: 18 },
	{ n: 3, name: 'Cấu hình và quy trình Claude Code', meta: '6 bài, 1 lab, 1 quiz', pct: 20 },
	{ n: 4, name: 'Prompt engineering và structured output', meta: '6 bài, 1 lab, 1 quiz', pct: 20 },
	{ n: 5, name: 'Quản lý context và độ tin cậy', meta: '6 bài, 1 lab, 1 quiz', pct: 15 },
];
---

<!doctype html>
<html lang="vi" data-type="software" data-radius="soft" data-ground="sand" data-buttons="solid" data-motion>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Hai khóa tự học tiếng Việt, miễn phí: Claude Certified Architect và System Design." />
		<meta property="og:image" content={`${site}share.jpg`} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<meta name="theme-color" content="#0f1f10" />
		<link rel="canonical" href={site} />
		<meta name="site-kind" content="software" />
		<meta name="page-type" content="software" />
		<!-- Giao diện: bảng màu đã chia (tối) là mặc định; "Sáng" chỉ khi người học đã chọn ở trang bài học. -->
		<script is:inline>
			(() => {
				let t = '';
				try {
					t = localStorage.getItem('starlight-theme') || '';
				} catch {}
				document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wdth,wght@85..100,400..700&family=IBM+Plex+Mono:wght@400&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href={`${kit}/system.css`} />
		<link rel="stylesheet" href={`${kit}/ui/cards.css`} />
		<link rel="stylesheet" href={`${kit}/motion/motion.css`} />
		<link rel="stylesheet" href={`${kit}/backgrounds/backgrounds.css`} />
		<link rel="stylesheet" href={`${kit}/layout/layout.css`} />
		<!-- start.mjs css --page software --palette forest-pale-lime --type plex --radius soft: giữ nguyên như script in ra -->
		<style is:inline>
			:root {
				--p-bg: #0f1f10; --p-surface: #162a17; --p-ink: #ffffff; --p-muted: #9aa39a;
				--p-accent: #c6f19d; --p-accent-ink: #0f1f10; --p-action: #c6f19d; --p-action-ink: #0f1f10;
				--p-inv-bg: #ffffff; --p-inv-surface: #ecedec; --p-inv-ink: #0f1f10; --p-inv-muted: #606c60;
				--p-inv-accent: #0f1f10; --p-inv-accent-ink: #ffffff; --p-inv-action: #0f1f10; --p-inv-action-ink: #ffffff;
				--font-display: "IBM Plex Sans", system-ui, sans-serif;
				--font-text: "IBM Plex Sans", system-ui, sans-serif;
				--font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
				--display-weight: 500;
				--display-tracking: -0.025em;
				--display-tracking-xl: -0.035em;
				--ly-scale: 0.98;
			}
		</style>
		<link rel="stylesheet" href={`${kit}/ui/base.css`} />
		<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
		<script is:inline src={`${kit}/backgrounds/backgrounds.js`}></script>
		<script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
		<link rel="modulepreload" href={`${kit}/moments/moments.js`} />
		<link rel="modulepreload" href={`${kit}/moments/lib.js`} />
		<link rel="modulepreload" href={`${kit}/moments/line-carries-colour/moment.js`} />
	</head>
	<body>
		<!-- type: software
		     deal: hero collage, nav nav-cards, close close-type, footer footer-statement, rhythm space, buttons solid, mark initial, ground sand
		     palette forest-pale-lime, type plex (IBM Plex Sans + IBM Plex Mono), radius soft, effect grain-gradient (hero art)
		     moments: line-carries-colour in #domain (the one section on another ground) -->
		<header class="nav">
			<div class="wrap nav__bar">
				<a class="skip-link" href="#top">Tới nội dung</a>
				<a class="nav__logo" href="#top"><span class="mark mark--initial" aria-hidden="true">K</span>Khóa học Architect</a>
				<nav class="nav__links" aria-label="Chính">
					<div class="nav__item">
						<a class="nav__link" href="#cca"
							>Khóa học <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"
								><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg
							></a
						>
						<div class="nav__menu">
							<div class="wrap grid">
								<a class="menu-card span-4" href={roadmap}>
									<div class="panel">
										<div class="stage stage--fade-br">
											<div class="at-corner">
												<div class="ui ui-mock k-ui k-card" aria-hidden="true">
													<div class="ccf-questions">
														<div class="ccf-q is-correct">
															<p class="ccf-q-text">Which condition should decide whether the loop runs another iteration?</p>
															<div class="ccf-options">
																<div class="ccf-opt is-picked"><span class="ccf-letter">B</span><span class="ccf-opt-text">The response <code>stop_reason</code> is <code>tool_use</code></span></div>
																<div class="ccf-opt"><span class="ccf-letter">C</span><span class="ccf-opt-text">The iteration counter is still below a fixed limit of 10</span></div>
															</div>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
									<span class="t-card">Lộ trình Claude Architect</span>
									<span class="t-small muted">29 bài và 5 lab chia theo 14 ngày</span>
								</a>
								<a class="menu-card span-4" href="#system-design">
									<div class="panel">
										<div class="stage stage--fade-br">
											<div class="at-corner">
												<div class="ui ui-mock k-ui k-card" aria-hidden="true">
													<p class="k-h">Flashcard</p>
													<div class="ccf-card">
														<span class="ccf-card-side">Câu hỏi</span>
														<span class="ccf-card-text">BFF (Backend for Frontend) là gì?</span>
													</div>
												</div>
											</div>
										</div>
									</div>
									<span class="t-card">System Design</span>
									<span class="t-small muted">38 bài, 65 câu hỏi, 307 flashcard</span>
								</a>
								<a class="menu-card span-4" href={exam}>
									<div class="panel">
										<div class="stage stage--fade-br">
											<div class="at-corner">
												<div class="ui ui-mock k-ui k-win" aria-hidden="true">
													<div class="k-win__body">
														<div class="ccf-exam-bar">
															<span class="ccf-exam-timer">118:42</span><span class="ccf-exam-count">Đã trả lời 1/60</span><span class="ccf-btn ccf-btn-primary">Nộp bài</span>
														</div>
														<div class="ccf-questions">
															<div class="ccf-q">
																<p class="ccf-q-text">In one response Claude requests three tool calls. How should the results be sent back?</p>
															</div>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
									<span class="t-card">Đề thi thử</span>
									<span class="t-small muted">60 câu trong 120 phút, chấm theo domain</span>
								</a>
							</div>
						</div>
					</div>
					<div class="nav__item"><a class="nav__link" href="#domain">Domain</a></div>
					<div class="nav__item"><a class="nav__link" href="#cong-cu">Công cụ</a></div>
					<div class="nav__item"><a class="nav__link" href="#faq">Hỏi đáp</a></div>
				</nav>
				<div class="nav__actions">
					<a class="btn btn--primary" href={cca}>Bắt đầu khóa Claude Architect</a>
				</div>
				<button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
					<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
				</button>
			</div>
		</header>

		<main id="top">
			<!-- HERO: collage. Chữ ở span-5; bên phải là cửa sổ thi thử trên nền sand, một thẻ kết quả đè góc dưới trái. -->
			<section class="hero hero--collage" data-enter aria-labelledby="hero-h">
				<div class="wrap">
					<div class="hero-text grid hero__grid">
						<div class="hero__text span-5">
							<h1 id="hero-h">Hai khóa tự học cho lập trình viên</h1>
							<p class="hero__lead">
								Luyện thi Claude Certified Architect qua 29 bài, 5 lab và đề thi thử 60 câu. Học System Design qua 38 bài và 307 flashcard. Miễn phí, bằng tiếng Việt.
							</p>
							<div class="btn-row">
								<a class="btn btn--primary" href={cca}
									>Bắt đầu khóa Claude Architect<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"
										><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg
									></a
								>
								<a class="btn btn--secondary" href={sd}>Xem khóa System Design</a>
							</div>
							<p class="hero__proof">Tài liệu không chính thức, không do Anthropic thực hiện hay bảo trợ.</p>
						</div>
						<div
							class="hero__art span-6 start-7"
							role="img"
							aria-label="Trang thi thử: đồng hồ còn 118 phút 42 giây, câu hỏi tiếng Anh với bốn phương án, và bảng kết quả theo từng domain"
							data-fx="grain-gradient"
							data-ui-pause-host
							data-fx-seed="7"
						>
							<div class="ly-piece ly-piece--main k-ui k-win" aria-hidden="true"><div class="ui ui-mock">
								<div class="k-win__bar">
									<span class="k-win__dots"><i></i><i></i><i></i></span><span>Thi thử · Claude Certified Architect</span>
								</div>
								<div class="k-win__body">
									<div class="ccf-exam-bar">
										<span class="ccf-exam-timer">118:42</span><span class="ccf-exam-count">Đã trả lời 1/60</span><span class="ccf-btn ccf-btn-primary">Nộp bài</span>
									</div>
									<div class="ccf-questions">
										<div class="ccf-q">
											<p class="ccf-q-text">
												A Messages API response contains a text block followed by a <code>tool_use</code> block, with <code>stop_reason: "tool_use"</code>. What must the application do next?
											</p>
											<div class="ccf-options">
												<div class="ccf-opt"><span class="ccf-letter">A</span><span class="ccf-opt-text">Show the text to the user and end the loop, because the model has replied</span></div>
												<div class="ccf-opt"><span class="ccf-letter">B</span><span class="ccf-opt-text">Send a new user message asking the model to continue</span></div>
												<div class="ccf-opt is-picked"><span class="ccf-letter">C</span><span class="ccf-opt-text">Execute the requested tool and return a <code>tool_result</code> block in a <code>user</code> message, then call the API again</span></div>
												<div class="ccf-opt"><span class="ccf-letter">D</span><span class="ccf-opt-text">Retry the same request until the response contains no <code>tool_use</code> block</span></div>
											</div>
										</div>
										<div class="ccf-q">
											<p class="ccf-q-text">In one response Claude requests three tool calls. How should the results be sent back?</p>
											<div class="ccf-options">
												<div class="ccf-opt"><span class="ccf-letter">A</span><span class="ccf-opt-text">As three <code>tool_result</code> blocks in a single <code>user</code> message, each with its own <code>tool_use_id</code></span></div>
												<div class="ccf-opt"><span class="ccf-letter">B</span><span class="ccf-opt-text">As three separate API requests, one result per request</span></div>
												<div class="ccf-opt"><span class="ccf-letter">C</span><span class="ccf-opt-text">As one concatenated string in the system prompt</span></div>
											</div>
										</div>
									</div>
								</div>
							</div></div>
							<div class="ly-piece ly-piece--note ui ui-mock k-ui k-card" aria-hidden="true">
								<p class="k-h">Đạt: 49/60 (82%)</p>
								<table class="ccf-exam-table">
									<thead><tr><th>Domain</th><th>Đúng</th><th>Tỉ lệ</th></tr></thead>
									<tbody>
										<tr><td>1. Kiến trúc agent</td><td>14/16</td><td>88%</td></tr>
										<tr><td>2. Tool và MCP</td><td>9/11</td><td>82%</td></tr>
										<tr class="is-weak"><td>3. Claude Code</td><td>8/12</td><td>67%</td></tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- APP-FRAME: sản phẩm ở kích thước thật. Trái: checklist theo ngày; phải: bài kiểm tra cuối bài 1.1 đã chấm. -->
			<section class="section" id="cca" aria-labelledby="cca-h">
				<div class="wrap">
					<div class="grid">
						<h2 class="span-5" id="cca-h">Mỗi bài học kết thúc bằng một bài kiểm tra</h2>
						<div class="span-6 start-7 stack-4">
							<p>
								Đọc bài, trả lời câu hỏi tiếng Anh như đề thật, rồi xem lời giải tiếng Việt cho từng phương án. Đúng hết trong một lượt thì bài được tích trong lộ trình 14 ngày.
							</p>
							<a class="link" href={roadmap}>Xem lộ trình 2 tuần</a>
						</div>
					</div>
					<div
						class="ui app fill"
						role="img"
						aria-label="Trang bài 1.1 Vòng lặp agent: checklist theo ngày ở bên trái, câu hỏi kiểm tra đã trả lời đúng với lời giải cho từng phương án ở bên phải"
					>
						<div class="app__pane app__pane--list" aria-hidden="true"><div class="ui ui-mock k-ui">
							<div class="app__head">
								<div class="ccf-tabs"><span class="k-tab is-on">Checklist</span><span class="k-tab">Ghi chú</span></div>
							</div>
							<div class="ccf-course-switch"><span class="k-switch is-on">Claude Certified Architect</span><span class="k-switch">System Design</span></div>
							<div class="ccf-progress"><div class="ccf-progress-bar" style="width: 2.5%"></div></div>
							<div class="app__body">
								<p class="ccf-muted">1/40 mục đã hoàn thành.</p>
								<p class="k-group">Ngày 1</p>
								<ul class="ccf-list">
									<li class="is-done"><span class="ccf-check">✓</span><a aria-current="page">1.1 · Vòng lặp agent</a></li>
									<li><span class="ccf-check"></span><a>1.2 · Kiểm soát vòng lặp</a></li>
								</ul>
								<p class="k-group">Ngày 2</p>
								<ul class="ccf-list">
									<li><span class="ccf-check"></span><a>1.3 · Coordinator và subagent</a></li>
									<li><span class="ccf-check"></span><a>1.4 · Phân rã nhiệm vụ</a></li>
								</ul>
								<p class="k-group">Ngày 3</p>
								<ul class="ccf-list">
									<li><span class="ccf-check"></span><a>1.5 · Hooks và ép buộc quy trình</a></li>
									<li><span class="ccf-check"></span><a>1.6 · Session, resume và fork</a></li>
									<li><span class="ccf-check"></span><a>1.7 · Lab — Nhóm phân tích sự cố</a><span class="ccf-tag">Lab</span></li>
									<li><span class="ccf-check"></span><a>1.8 · Quiz Domain 1</a><span class="ccf-tag">Quiz</span></li>
								</ul>
								<p class="k-group">Ngày 4</p>
								<ul class="ccf-list">
									<li><span class="ccf-check"></span><a>2.1 · Viết mô tả tool</a></li>
									<li><span class="ccf-check"></span><a>2.2 · Lỗi có cấu trúc và isError</a></li>
									<li><span class="ccf-check"></span><a>2.3 · Chia tool cho agent và tool_choice</a></li>
								</ul>
							</div>
						</div>
						</div><div class="app__pane app__pane--open" aria-hidden="true">
							<div class="app__doc ui ui-mock k-ui">
								<p class="app__crumb">1.1 · Vòng lặp agent</p>
								<p class="k-h">Kiểm tra cuối bài</p>
								<div class="ccf-questions">
									<div class="ccf-q is-correct">
										<p class="ccf-q-text">
											You are implementing an agentic loop directly on the Messages API. Which condition should decide whether the loop runs another iteration?
										</p>
										<div class="ccf-options">
											<div class="ccf-opt"><span class="ccf-letter">A</span><span class="ccf-opt-text">The assistant text contains a phrase such as 'Task complete'</span></div>
											<div class="ccf-opt is-picked"><span class="ccf-letter">B</span><span class="ccf-opt-text">The response <code>stop_reason</code> is <code>tool_use</code></span></div>
											<div class="ccf-opt"><span class="ccf-letter">C</span><span class="ccf-opt-text">The iteration counter is still below a fixed limit of 10</span></div>
											<div class="ccf-opt"><span class="ccf-letter">D</span><span class="ccf-opt-text">The response contains at least one text block</span></div>
										</div>
										<div class="ccf-feedback">
											<p class="ccf-verdict">✓ Đúng</p>
											<ul class="ccf-why">
												<li><strong>✗ A.</strong> Đây là phân tích ngôn ngữ tự nhiên để đoán trạng thái. Model có thể diễn đạt khác đi, hoặc viết câu đó khi vẫn còn gọi tool.</li>
												<li class="ok"><strong>✓ B.</strong> Đúng. <code>tool_use</code> nghĩa là model đang chờ kết quả tool, nên phải chạy tool rồi gọi lại.</li>
												<li><strong>✗ C.</strong> Giới hạn số vòng là lưới an toàn, không phải điều kiện dừng chính.</li>
												<li><strong>✗ D.</strong> Một phản hồi có thể vừa có text vừa có <code>tool_use</code>.</li>
											</ul>
